; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Roguelike Studio"
config/description="俯视角自动射击肉鸽游戏 - 类 Brotato"
run/main_scene="res://scenes/CharacterSelect.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
DataLoader="*res://scripts/autoload/data_loader.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
; 2026-08-05 试玩反馈：viewport 模式把 UI 文本按 640x360 栅格化再 2x 放大 → 字体发糊。
; 改 canvas_items + integer：UI/文本按窗口 1280x720 渲染（锐利），世界像素精灵仍整数倍放大（像素完美）。
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[gui]

; 全局默认字体 = 系统字体（微软雅黑优先，矢量渲染 + 完整中文），替换 Godot 内置默认字体
theme/custom="res://assets/ui/theme.tres"

