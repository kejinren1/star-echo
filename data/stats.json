  "formulas": {
    "damage": "final_damage = (weapon_base_damage + damage_stat) * crit_check",
    "crit_check": "if random() < crit_chance: * crit_damage_multiplier, else: * 1.0",
    "armor_reduction": "damage_reduction = min(armor / (armor + 20), 0.75)",
    "armor_final": "final_damage = raw_damage * (1 - damage_reduction)",
    "attack_speed": "actual_cooldown = weapon_base_cooldown / (1 + attack_speed_percent / 100)",
    "attack_speed_min": "min_cooldown = 0.1s",
    "dodge": "if random() < min(dodge_percent/100, 0.60): ignore_damage",
    "knockback": "knockback_distance = base_knockback + knockback_stat",
    "harvesting": "bonus_materials_per_wave = harvesting_stat",
    "luck_shop": "high_quality_chance = base_chance + luck * 0.5%",
    "luck_chest": "chest_drop_chance = base_chance + luck * 0.3%",
    "curse_hp": "enemy_hp_multiplier = 1.5 + curse * 0.02",
    "curse_damage": "enemy_damage_multiplier = 1.25",
    "curse_speed": "enemy_speed_multiplier = 1.15",
    "curse_drop": "material_drop_multiplier = 1.33"
  },
  "leveling": {
    "xp_per_level": "20 + current_level * 10",
    "choices_per_level": 3,
    "upgrade_options": [
      { "group": "damage", "options": ["+5 melee_damage", "+5 ranged_damage", "+5 elemental_damage"] },
      { "group": "offense", "options": ["+5% attack_speed", "+5% crit_chance", "+5 range"] },
      { "group": "defense", "options": ["+5 max_hp", "+1 armor", "+5% dodge"] },
      { "group": "economy", "options": ["+3 harvesting", "+5 luck", "+3 engineering"] }
